# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# Database (local MongoDB or a MongoDB Atlas connection string)
MONGO_URI=mongodb://127.0.0.1:27017/hcm_lite

# Auth
JWT_SECRET=change-this-to-a-long-random-string
# Optional: first-run will pre-create the Admin account from these values
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# AI assistant (any OpenAI-compatible API with tool calling)
# Examples:
#   OpenAI: AI_BASE_URL=https://api.openai.com/v1   AI_MODEL=gpt-4o-mini
#   Groq:   AI_BASE_URL=https://api.groq.com/openai/v1  AI_MODEL=llama-3.3-70b-versatile
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
